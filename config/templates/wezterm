# yami-output: ~/.config/wezterm/colors/yami.toml
# yami: the palette as a wezterm scheme; in wezterm.lua: config.color_scheme = "yami"

[colors]
foreground = "{{text}}"
background = "{{bg}}"
cursor_bg = "{{accent}}"
cursor_fg = "{{bg}}"
cursor_border = "{{accent}}"
selection_bg = "{{selection}}"
selection_fg = "{{textHi}}"
split = "{{border}}"
ansi = ["{{color0}}", "{{color1}}", "{{color2}}", "{{color3}}", "{{color4}}", "{{color5}}", "{{color6}}", "{{color7}}"]
brights = ["{{color8}}", "{{color9}}", "{{color10}}", "{{color11}}", "{{color12}}", "{{color13}}", "{{color14}}", "{{color15}}"]

[metadata]
name = "yami"
