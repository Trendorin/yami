# yami-output: ~/.config/alacritty/yami.toml
# yami: the palette for alacritty; in alacritty.toml: [general] import = ["~/.config/alacritty/yami.toml"]

[colors.primary]
background = "{{bg}}"
foreground = "{{text}}"

[colors.cursor]
cursor = "{{accent}}"
text = "{{bg}}"

[colors.selection]
background = "{{selection}}"
text = "{{textHi}}"

[colors.normal]
black = "{{color0}}"
red = "{{color1}}"
green = "{{color2}}"
yellow = "{{color3}}"
blue = "{{color4}}"
magenta = "{{color5}}"
cyan = "{{color6}}"
white = "{{color7}}"

[colors.bright]
black = "{{color8}}"
red = "{{color9}}"
green = "{{color10}}"
yellow = "{{color11}}"
blue = "{{color12}}"
magenta = "{{color13}}"
cyan = "{{color14}}"
white = "{{color15}}"
