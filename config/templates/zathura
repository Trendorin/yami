# yami-output: ~/.config/zathura/yami
# yami: the palette for zathura; in zathurarc: include yami
set default-bg "{{bg}}"
set default-fg "{{text}}"
set statusbar-bg "{{panel}}"
set statusbar-fg "{{text}}"
set inputbar-bg "{{panel}}"
set inputbar-fg "{{text}}"
set notification-bg "{{surface}}"
set notification-fg "{{text}}"
set notification-error-bg "{{surface}}"
set notification-error-fg "{{color1}}"
set notification-warning-bg "{{surface}}"
set notification-warning-fg "{{warn}}"
set highlight-color "{{selection}}"
set highlight-active-color "{{accent}}"
set completion-bg "{{surface}}"
set completion-fg "{{text}}"
set completion-group-bg "{{panel}}"
set completion-group-fg "{{textDim}}"
set completion-highlight-bg "{{selection}}"
set completion-highlight-fg "{{textHi}}"
set index-bg "{{bg}}"
set index-fg "{{text}}"
set index-active-bg "{{selection}}"
set index-active-fg "{{textHi}}"
set recolor-lightcolor "{{bg}}"
set recolor-darkcolor "{{text}}"
